---
# Inherits the repository-wide rules, with two exceptions.
#
# MU_CHECK/MU_ASSERT expand to a fprintf() call whose result is deliberately
# ignored, which trips both of these on every single assertion:
#   - cert-err33-c
#   - clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling
# They stay enabled for the library itself, where an ignored return value is a
# real defect.
InheritParentConfig: true
Checks: '-cert-err33-c,-clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling'
...
